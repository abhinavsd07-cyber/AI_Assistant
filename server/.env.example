PORT=5000
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
ALLOWED_ORIGINS=http://localhost:5173,https://nebula-ai-assistant.onrender.com

# Cloudinary Media CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Billing (Sandbox sk_test_... or Live sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd

# Optional Razorpay UPI/Card Checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Transactional Email for Forgot-Password Flows (HTTPS Webhook, SMTP, or Resend)
EMAIL_WEBHOOK_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nebula AI <onboarding@resend.dev>

# Dedicated Watermark-Free FLUX.1 Image Generation Providers (configure ANY ONE for official studio-grade FLUX.1)
# 1. Hugging Face Official FLUX.1-dev / FLUX.1-schnell (Free token at https://huggingface.co/settings/tokens)
HF_TOKEN=
# 2. Cloudflare Workers AI FLUX.1-schnell (Free 10,000 neurons/day at https://dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 3. Together AI FLUX.1-schnell / FLUX.1-dev (https://api.together.xyz)
TOGETHER_API_KEY=
# 4. Pollinations Pro Gateway (https://enter.pollinations.ai/keys)
POLLINATIONS_API_KEY=
